# ==============================================================================
# SehatSetu Environment Configuration Template (.env.example)
# IMPORTANT: Never commit actual secrets or production keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase / PostgreSQL Connection
# For backend database connections (use pooled connection in production)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# JWT Verification (Supabase Auth JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Optional AI / LLM Configuration (e.g., Google Gemini for Symptom Summarization)
GEMINI_API_KEY=your-gemini-api-key-placeholder
AI_MODEL_NAME=gemini-1.5-flash
ENABLE_AI_SUMMARIZATION=false

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite / React)
# Note: In Vite, client-accessible variables must be prefixed with VITE_
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VITE_ENABLE_REALTIME=true
VITE_APP_ENV=development
